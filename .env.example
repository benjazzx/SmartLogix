# Copia este archivo como .env y completa los valores antes de ejecutar docker compose up
# NUNCA subas .env a Git — ya está en .gitignore

# Clave secreta JWT (mínimo 32 caracteres, usa un valor aleatorio en producción)
JWT_SECRET=reemplaza_con_una_clave_secreta_aleatoria_de_al_menos_32_caracteres

# Contraseña de PostgreSQL local
SPRING_DATASOURCE_PASSWORD=postgres

# Perfil de Spring (dev activa el DataInitializer con datos de prueba)
SPRING_PROFILES_ACTIVE=dev
