# Copia este archivo como .env y completa los valores antes de ejecutar docker compose up
# NUNCA subas .env a Git — ya está en .gitignore

# Clave secreta JWT (mínimo 32 caracteres, usa un valor aleatorio en producción)
JWT_SECRET=reemplaza_con_una_clave_secreta_aleatoria_de_al_menos_32_caracteres

# Contraseña de PostgreSQL local
SPRING_DATASOURCE_PASSWORD=postgres

# Clave compartida para llamadas internas Inventario <-> Producto
INTERNAL_SERVICE_KEY=reemplaza_con_una_clave_interna_aleatoria

# Perfil de Spring (dev activa el DataInitializer con datos de prueba)
SPRING_PROFILES_ACTIVE=dev

# Contraseñas de las cuentas semilla del perfil dev — NO usar estos valores
# ni los de ningún ejemplo en un despliegue público. El servicio Users falla
# al iniciar si faltan (no hay contraseñas hardcodeadas en el código).
SEED_ADMIN_PASSWORD=reemplaza_con_una_clave_aleatoria
SEED_BODEGUERO_PASSWORD=reemplaza_con_una_clave_aleatoria
SEED_TRANSPORTISTA_PASSWORD=reemplaza_con_una_clave_aleatoria
SEED_CLIENTE_PASSWORD=reemplaza_con_una_clave_aleatoria
