# Variables de entorno — NUNCA subir a Git
.env
.env.txt
*.env

# Secrets reales de k8s — solo se versiona secrets.example.yaml (placeholders)
k8s/secrets.yaml
k8s/*.secrets.yaml
k8s/secrets.local.yaml

# Datos de siembra con hashes de contraseñas reales — nunca versionar
seed.sql

# Terraform — variables reales (tenant IDs, contraseñas, claves) y artefactos locales
*.tfvars
terraform/aws-ep1/build/
terraform/aws-ep1/.terraform/
*.tfstate
*.tfstate.*
tfplan*

# Backups locales, no se versionan
*.bak

# node_modules del Lambda Authorizer (se instala local antes de terraform apply)
lambda-authorizer/node_modules/

# Claude Code (interno)
.claude/

# Maven
target/
*.class
*.jar
*.war

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db
